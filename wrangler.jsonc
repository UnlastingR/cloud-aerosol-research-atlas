{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-aerosol-research-atlas",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "tracks.fyzure.fyi",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
